{
  "manifest_version": 3,
  "name": "TSU Whatnot Sale Bridge",
  "version": "1.0",
  "description": "Scrape Whatnot sale UI and push to the TSU SSE bridge.",
"host_permissions": [
  "https://*.whatnot.com/*",
  "https://tsu-bridge*.onrender.com/*",
  "https://*card-break-overlay.onrender.com/*"
],
"content_scripts": [{
  "matches": ["https://*.whatnot.com/*"],
  "js": ["content.js"],
  "run_at": "document_idle",
  "all_frames": true
}]

}
