{
  "manifest_version": 3,
  "name": "TSU Bridge (Whatnot) - Card Cave",
  "version": "3.0.1",
  "description": "TSU unified v3.0.1 baked for Card Cave (@cardcave956). Sales/overlay bridge (content.js v2.3.5, MLS added) plus the dormant chat bot. Supersedes card-cave-extension-2026-09-05.zip, which had the wrong seller handle baked.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.whatnot.com/*",
    "https://*.whatnot.com/*",
    "https://bridge.tradesecretsunlocked.com/*",
    "https://*.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.whatnot.com/*",
        "https://*.whatnot.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.whatnot.com/live/*",
        "https://www.whatnot.com/dashboard/live/*",
        "https://www.whatnot.com/user/*"
      ],
      "js": [
        "bot-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected.js",
        "bot-injected.js"
      ],
      "matches": [
        "https://www.whatnot.com/*",
        "https://*.whatnot.com/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "TSU Bridge + Bot"
  }
}