# ─── TSU Bridge Environment Variables ───────────────────────────────────────
# Copy this file to .env for local development.
# On Render, set these in the "Environment" tab of your Web Service.

# Port (Render sets this automatically — don't override in production)
PORT=10000

# Supabase — get these from your project's Settings > API page
# Leave blank to run without event logging (bridge still works)
SUPABASE_URL=https://your-project-ref.supabase.co

# REQUIRED before enabling RLS for the client portal. The service-role key
# bypasses RLS so the bridge keeps validating keys + logging events once the
# tables are locked down. Keep it SECRET — server-side only, never shipped to
# overlays/extensions. Settings > API > service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Legacy fallback — used only if SUPABASE_SERVICE_ROLE_KEY is unset.
SUPABASE_ANON_KEY=your-anon-key-here

# Set to "false" to disable ESPN score polling (saves outbound requests)
ESPN_ENABLED=true
