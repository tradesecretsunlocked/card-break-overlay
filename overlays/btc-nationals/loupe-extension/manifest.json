{
  "manifest_version": 3,
  "name": "TSU Bridge - Bigger Than Cardboard (Loupe)",
  "version": "1.0.0",
  "description": "TSU Loupe sale bridge for Bigger Than Cardboard, The National charity auction.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.loupetheapp.com/*",
    "https://firestore.googleapis.com/*",
    "https://bridge.tradesecretsunlocked.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.loupetheapp.com/*"
      ],
      "js": [
        "loupe-content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}